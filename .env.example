# .env.example — 复制为 .env 并填入真实值
TENCENT_SECRET_ID=你的腾讯云SecretId
TENCENT_SECRET_KEY=你的腾讯云SecretKey
COS_REGION=ap-singapore
COS_BUCKET=baozehang-1416231675
DATABASE_URL=sqlite:///./file_records.db

# 预览预签名 URL 有效期（秒），缺省 3600
COS_SIGNED_URL_EXPIRE_SECONDS=3600
# 图片缓存 TTL（秒），缺省 3000（缓存层在 WMS 主系统，此处备用）
IMAGE_CACHE_TTL_SECONDS=3000
# CORS 白名单（逗号分隔）；不要使用 "*" 搭配 credentials=true
CORS_ALLOW_ORIGINS=https://api.zedabeauty.uk,https://file.zedabeauty.uk
